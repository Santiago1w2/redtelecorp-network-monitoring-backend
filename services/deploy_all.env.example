# Configuración Bash local. No guardar claves, JWT ni contraseñas aquí.
STAGE=dev
AWS_REGION=us-east-1
FRONTEND_ORIGIN='https://REEMPLAZAR_POR_FRONTEND_REAL'
ADMIN_EMAILS='santiago.morales@utec.edu.pe'

# IA opcional. SSM SecureString es la fuente predeterminada de x-api-key.
AI_ENABLED=false
GCP_AI_BASE_URL=''
GCP_AI_API_KEY_PARAM='/telecorp/dev/gcp/ai-api-key'
# Opcional: sustituye SSM por un secreto JSON {"api_key":"..."}.
GCP_AI_SECRET_ARN=''
GCP_AUTH_MODE=WIF
GCP_WIF_AUDIENCE=''
GCP_INVOKER_SERVICE_ACCOUNT=''
COLLECTIVE_REPORT_THRESHOLD=10
RECURRENT_ANTENNA_MIN_EVENTS=3
RECURRENT_ANTENNA_MIN_DAYS=2
RECURRENT_ANTENNA_WINDOW_DAYS=7
REQUIRED_FIELD_SKILL=NETWORK

ORACLE_ENABLED=false
ORACLE_SECRET_ARN='arn:aws:secretsmanager:us-east-1:573505212581:secret:rtc/oracle/spatial/dev-XK8lxx'
ORACLE_SECURITY_GROUP_IDS=''
ORACLE_SUBNET_IDS=''
DELIVERY_ENABLED=false
# 05 es el propietario canónico de reportes. Habilitar 07 solo durante migración.
DEPLOY_LEGACY_REPORTS=false

# Auto reutiliza el bus si existe y conserva el stack propietario.
EVENT_BUS_NAME=''
CREATE_EVENT_BUS=auto
SERVERLESS_BIN=serverless
PYTHON_BIN=python3
# AWS_PROFILE=redtelecorp
