# Configuración Bash local. No guardar claves, JWT ni contraseñas aquí.
STAGE=dev
AWS_REGION=us-east-1
FRONTEND_ORIGIN='https://example.com'
ADMIN_EMAILS='santiago.morales@utec.edu.pe'

# IA opcional. SSM SecureString es la fuente predeterminada de x-api-key.
AI_ENABLED=true
GCP_AI_BASE_URL='https://ms6-ai-intelligence-363730882994.us-central1.run.app'
GCP_AI_API_KEY_PARAM='/telecorp/dev/gcp/ai-api-key'
# Opcional: sustituye SSM por un secreto JSON {"api_key":"..."}.
GCP_AI_SECRET_ARN=''
GCP_AUTH_MODE=WIF
GCP_WIF_AUDIENCE=''
GCP_INVOKER_SERVICE_ACCOUNT=''
COLLECTIVE_REPORT_THRESHOLD=10
RECURRENT_ANTENNA_MIN_EVENTS=3
RECURRENT_ANTENNA_MIN_DAYS=2
RECURRENT_ANTENNA_WINDOW_DAYS=7
REQUIRED_FIELD_SKILL=NETWORK

# Simulador opcional de 20 antenas demo; activar despues de ejecutar el preparador.
SIMULATOR_ENABLED=true
SIMULATOR_SAMPLE_SIZE=5
SIMULATOR_ANTENNA_IDS='ANT-SIM-57db94c623354f79b9d5c8289205d660,ANT-SIM-25cd582d9a974b59879018015f0eb83c,ANT-SIM-3940fefb89bd459a9ea2162eb5c72af4,ANT-SIM-cac98625108f466e906a237f9be131a3,ANT-SIM-a5cb2bab7ff0484a9c21128e1355d8d6,ANT-SIM-61f9f98f5b0a43eb9b26aae794d1cc5a,ANT-SIM-47e0ef7d5f214191891cf2a64156adf9,ANT-SIM-00310e3740af4082a27e7fae2cfcbb33,ANT-SIM-45d3f281673b433aaf3dd82babeeee74,ANT-SIM-61141bea11724778a8974d99a4d27822,ANT-SIM-cafead82f20c4665aee38de42d70f7c6,ANT-SIM-610aca06bc0c4084b83b55d3116f80e9,ANT-SIM-befd147e1b274fe39778ba58dd1f7e56,ANT-SIM-09ef8145dfc7425daa78b413864646b4,ANT-SIM-d75eadbfceaa4607986cffed6680fd5d,ANT-SIM-4177f6c1e35f4d6783260992e9d74509,ANT-SIM-00ef4d1ebf544ebd893bacd5f060de57,ANT-SIM-402653072a3e45bd969d9eab3f232f25,ANT-SIM-50d2fe52353048ac8cd903430ffadcdb,ANT-SIM-5e067b358d424412be3ebf7115112043'


ORACLE_ENABLED=true
ORACLE_SECRET_ARN='arn:aws:secretsmanager:us-east-1:573505212581:secret:rtc/oracle/spatial/dev-XK8lxx'
# existing reutiliza la red de dev sin crear otro NAT. create crea una red administrada.
NETWORK_MODE=existing
NETWORK_VPC_ID='vpc-0bbf2ecd85925f839'
NETWORK_EGRESS_IP='44.199.117.193'
ORACLE_TLS_PORT=1521
# Entradas solo para existing; en create se leen automaticamente del stack rtc-network-dev.
ORACLE_SECURITY_GROUP_IDS='sg-073441fce8eae8dff'
ORACLE_SUBNET_IDS='subnet-00d8e8be43d3c8dd3,subnet-058b1550e4f51165c'
DELIVERY_ENABLED=true
# 05 es el propietario canónico de reportes. Habilitar 07 solo durante migración.
DEPLOY_LEGACY_REPORTS=false

# Auto reutiliza el bus si existe y conserva el stack propietario.
EVENT_BUS_NAME=''
CREATE_EVENT_BUS=auto
SERVERLESS_BIN=serverless
PYTHON_BIN=python3
