# Copia a deploy_ec2.env (ignorado por Git). Es sintaxis Bash: sin espacios alrededor de =.
STAGE=dev
AWS_REGION=us-east-1

# OBLIGATORIOS: completar con valores reales; no se inventan un frontend ni un authorizer.
FRONTEND_ORIGIN=''
IDENTITY_AUTHORIZER_ARN=''

# Vacío usa arn:aws:iam::<cuenta autenticada>:role/LabRole.
# El rol debe existir y tener los permisos indicados en EC2_Y_POSTMAN.md.
LAMBDA_ROLE_ARN=''

# Vacío usa rtc-events-<stage>. auto conserva la propiedad del bus en actualizaciones.
EVENT_BUS_NAME=''
CREATE_EVENT_BUS=auto

# URLs base SIN /v1 ni barra final. Deben exponer los contratos de los servicios 01/02/07.
INFRASTRUCTURE_API_URL=''
IDENTITY_API_URL=''
REPORTS_API_URL=''

# ARNs execute-api autorizados por el administrador de LabRole (no crea permisos).
INFRASTRUCTURE_API_ARN=''
IDENTITY_API_ARN=''
REPORTS_API_ARN=''

MAX_BATCH=100
DELIVERY_ENABLED=false
SES_FROM_ADDRESS=''
SES_IDENTITY=''
ORACLE_ENABLED=false
ORACLE_SECRET_ARN=''

# Herramientas ya instaladas en la EC2. Se permite una ruta a un ejecutable.
SERVERLESS_BIN=serverless
PYTHON_BIN=python3

# Preferir IAM instance profile en EC2. Si usas un perfil local, descomenta:
# AWS_PROFILE=redtelecorp
# No guardar claves AWS, JWT, contraseñas ni claves de Serverless aquí.
