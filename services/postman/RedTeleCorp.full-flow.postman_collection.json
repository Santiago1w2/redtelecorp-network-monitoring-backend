            ]
          }
        }
      ]
    },
    {
      "name": "13 Obtener orden esperar asignacion",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{field_base_url}}/work-orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
              "const rows=(pm.response.json().workOrders||{}).items||[]; const row=rows.find(x=>x.incidentId===pm.environment.get(\"incident_id\")); pm.test(\"Orden creada\",()=>pm.expect(row).to.exist); if(row)pm.environment.set(\"work_order_id\",row.workOrderId);"
            ]
          }
        }
      ]
    },
