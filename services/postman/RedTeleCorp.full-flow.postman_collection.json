          }
        ],
        "url": "{{telemetry_base_url}}/v1/telemetry",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"antenna_id\": \"{{antenna_id}}\",\n  \"timestamp\": \"{{telemetry_timestamp}}\",\n  \"traffic_gb_min\": 80\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([202]));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Comprobar NORMAL esperar si esta procesando",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{telemetry_base_url}}/v1/telemetry/antennas/{{antenna_id}}/latest"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
              "pm.test(\"Estado NORMAL\", () => pm.expect(pm.response.json().status).to.equal(\"NORMAL\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Crear reporte del usuario autenticado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{reports_base_url}}/reports",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"+51900000000\",\n  \"zoneId\": \"{{zone_id}}\",\n  \"occurredAt\": \"{{telemetry_timestamp}}\",\n  \"problemType\": \"NO_SIGNAL\",\n  \"description\": \"Reporte ficticio para validar integracion\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([201]));",
              "const r=pm.response.json().report; pm.environment.set(\"report_id\",r.reportId); pm.environment.set(\"recipient_id\",r.userId);"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Provocar DOWN",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{telemetry_base_url}}/v1/telemetry",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"antenna_id\": \"{{antenna_id}}\",\n  \"timestamp\": \"{{telemetry_timestamp}}\",\n  \"traffic_gb_min\": 20\n}"
        }
      },
      "event": [
        {
          "listen": "test",
