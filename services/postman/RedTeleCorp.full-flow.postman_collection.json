        "url": "{{coverage_base_url}}/v1/coverage/antennas/{{antenna_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"latitude\": -12.105,\n  \"longitude\": -77.035,\n  \"coverage_radius_m\": 1500,\n  \"coverage_model\": \"ESTIMATED_CIRCLE\",\n  \"zone_id\": \"{{zone_id}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([200]));"
            ]
          }
        }
      ]
    },
