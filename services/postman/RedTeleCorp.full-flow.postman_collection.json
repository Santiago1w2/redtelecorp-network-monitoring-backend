{
  "info": {
    "name": "Red TeleCorp - primera prueba completa",
    "_postman_id": "c0793881-fc39-4ec3-8a0e-85557a7e0a08",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Usar un IdToken de admin confirmado. Ejecutar por etapas y esperar SQS/Streams/Step Functions en 08,11,13,17,19. No confundir HTTP 202 con procesamiento terminado. Solo datos ficticios e IN_APP."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{cognito_id_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.environment.set(\"telemetry_timestamp\",new Date().toISOString());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Crear estacion",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{infrastructure_base_url}}/stations",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"stationId\": \"{{station_id}}\",\n  \"name\": \"Estacion de prueba\",\n  \"zoneId\": \"{{zone_id}}\",\n  \"latitude\": -12.105,\n  \"longitude\": -77.035\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Crear antena",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{infrastructure_base_url}}/antennas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"antenna_id\": \"{{antenna_id}}\",\n  \"stationId\": \"{{station_id}}\",\n  \"name\": \"Antena de prueba\",\n  \"technology\": \"4G\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Crear zona",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{coverage_base_url}}/v1/coverage/zones",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"zone_id\": \"{{zone_id}}\",\n  \"name\": \"Zona de prueba\",\n  \"zone_type\": \"HEALTHCARE\",\n  \"criticality\": \"HIGH\",\n  \"geometry\": {\n    \"type\": \"Polygon\",\n    \"coordinates\": [\n      [\n        [\n          -77.04,\n          -12.1\n        ],\n        [\n          -77.03,\n          -12.1\n        ],\n        [\n          -77.03,\n          -12.11\n        ],\n        [\n          -77.04,\n          -12.11\n        ],\n        [\n          -77.04,\n          -12.1\n        ]\n      ]\n    ]\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Asignar cobertura a zona",
