              "pm.test(\"Incidente SOLUCIONADA\",()=>pm.expect(pm.response.json().detalle.estado).to.equal(\"SOLUCIONADA\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "19 Obtener notificacion de resolucion",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{notifications_base_url}}/v1/notifications"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
              "const rows=pm.response.json().notifications||[];const row=rows.find(x=>x.incident_id===pm.environment.get(\"incident_id\")&&x.template===\"INCIDENT_RESOLVED\");pm.test(\"Notificacion de resolucion\",()=>pm.expect(row).to.exist);if(row)pm.environment.set(\"notification_id\",row.notification_id);"
            ]
