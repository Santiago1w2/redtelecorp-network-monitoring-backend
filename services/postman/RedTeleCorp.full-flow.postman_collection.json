            ]
          }
        }
      ]
    },
    {
      "name": "11 Obtener incidente esperar orquestacion",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{incidents_base_url}}/incidencias?tipo=colectivos&zona={{zone_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
              "const rows=pm.response.json().incidentes||[]; pm.test(\"Incidente creado\",()=>pm.expect(rows.length).to.be.above(0)); if(rows.length) pm.environment.set(\"incident_id\",rows[0].incidenteId);"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Detalle del incidente",
      "request": {
